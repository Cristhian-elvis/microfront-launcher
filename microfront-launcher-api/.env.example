# Las credenciales Basic Auth se obtienen de clientCredentials en el
# app-config.json de la webapp seleccionada. No definas secretos aquí.
#
# Opcionales: los valores por defecto son los endpoints de HCEN usados actualmente.
AUTH_TICKET_URL=https://corewsintra.val.comunidad.madrid/auto_rest_beta/v3/ticket/mock/HSTA_WEBAPP_PROFESIONAL/HSTA_WEB_PRIVADO
AUTH_TOKEN_URL=https://apiscmintra.val.comunidad.madrid/token
# Grant OAuth enviado al endpoint de token (por ejemplo: autologin).
AUTH_TOKEN_GRANT_TYPE=autologin
