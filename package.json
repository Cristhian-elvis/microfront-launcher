{
  "name": "microfront-launcher-workspace",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "microfront-launcher",
    "microfront-launcher-api"
  ],
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run start:api\" \"npm run start:web\"",
    "start:api": "npm --workspace microfront-launcher-api run start",
    "start:web": "npm --workspace microfront-launcher run start -- --open",
    "install:all": "npm install",
    "release:microfront": "node scripts/release-microfront.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
